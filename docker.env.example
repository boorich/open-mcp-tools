# Docker Compose Environment Configuration
# Rename this file to .env and customize for your setup

# Path to price lists directory (default: ./resources/pricelists)
# This directory will be mounted into the Docker container for Excel files and database
#
# Examples:
#   PRICELISTS_DIR=./resources/pricelists          # Relative to docker-compose.yml (default)
#   PRICELISTS_DIR=/home/kunde/preislisten         # Absolute path
#   PRICELISTS_DIR=~/Documents/otto-mayer/prices   # Home directory
#
PRICELISTS_DIR=./resources/pricelists

# Optional: Port for MCP server (default: 7284)
# Only change if port 7284 is already in use
# MCP_PORT=7284

