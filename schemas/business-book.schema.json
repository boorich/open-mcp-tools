{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Business Book Resource Schema",
  "description": "Schema for business and self-help book resources",
  "type": "object",
  "required": ["name", "title", "author", "category"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique identifier (slug format)"
    },
    "title": {
      "type": "string",
      "description": "Full title of the book"
    },
    "subtitle": {
      "type": ["string", "null"],
      "description": "Subtitle if available"
    },
    "author": {
      "type": "string",
      "description": "Author(s) of the book"
    },
    "publication_year": {
      "type": ["integer", "null"],
      "description": "Year of publication"
    },
    "isbn": {
      "type": ["string", "null"],
      "description": "ISBN number"
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Language code (ISO 639-1)"
    },
    "description": {
      "type": "string",
      "description": "Brief description or synopsis of the book"
    },
    "category": {
      "type": "string",
      "enum": ["business", "leadership", "productivity", "entrepreneurship", "management", "self-help", "strategy", "marketing", "sales", "finance"],
      "description": "Primary category"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords and topics covered"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "title"],
        "properties": {
          "number": {
            "type": "integer",
            "description": "Chapter number"
          },
          "title": {
            "type": "string",
            "description": "Chapter title"
          },
          "summary": {
            "type": ["string", "null"],
            "description": "Brief summary of the chapter"
          },
          "key_concepts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Main concepts introduced in this chapter"
          },
          "page": {
            "type": ["integer", "null"],
            "description": "Starting page number"
          }
        }
      }
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the framework/model"
          },
          "description": {
            "type": "string",
            "description": "Explanation of the framework"
          },
          "chapter": {
            "type": ["integer", "null"],
            "description": "Chapter where it's introduced"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Parts or steps of the framework"
          },
          "application": {
            "type": ["string", "null"],
            "description": "How to apply this framework"
          }
        }
      },
      "description": "Key frameworks, models, and methodologies in the book"
    },
    "key_takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main insights and lessons from the book"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "description"],
        "properties": {
          "action": {
            "type": "string",
            "description": "Action to take"
          },
          "description": {
            "type": "string",
            "description": "Details about the action"
          },
          "chapter": {
            "type": ["integer", "null"],
            "description": "Related chapter"
          },
          "difficulty": {
            "type": ["string", "null"],
            "enum": ["easy", "medium", "hard", null],
            "description": "Implementation difficulty"
          }
        }
      },
      "description": "Actionable items and exercises from the book"
    },
    "target_audience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Who this book is for"
    },
    "version": {
      "type": "string",
      "description": "Version of this resource"
    },
    "category_type": {
      "type": "string",
      "const": "business-books",
      "description": "Resource category type"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this resource was created"
    },
    "source_pdf": {
      "type": ["string", "null"],
      "description": "Path to source PDF file"
    }
  }
}

